
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 290" width="800" height="290" role="img" aria-label="Animated waving robot saying Hello, World" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#164E63"/>
      <stop offset="1" stop-color="#0A101F"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#22D3EE" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#22D3EE" stop-opacity="0"/>
    </radialGradient>
    <clipPath id="typeclip">
      <rect x="484" y="46" width="0" height="30">
        <animate attributeName="width" values="0;150;150;150;0" keyTimes="0;0.35;0.85;0.95;1" dur="6s" repeatCount="indefinite"/>
      </rect>
    </clipPath>
  </defs>

  <!-- twinkling stars -->
  <g fill="#D7E0F2">
    <circle cx="60" cy="40" r="1.8"><animate attributeName="opacity" values="0.1;1;0.1" dur="2.4s" repeatCount="indefinite"/></circle>
    <circle cx="140" cy="90" r="1.3"><animate attributeName="opacity" values="1;0.1;1" dur="3.1s" repeatCount="indefinite"/></circle>
    <circle cx="250" cy="30" r="1.6"><animate attributeName="opacity" values="0.2;1;0.2" dur="2.8s" repeatCount="indefinite"/></circle>
    <circle cx="330" cy="70" r="1.2"><animate attributeName="opacity" values="1;0.2;1" dur="2.2s" repeatCount="indefinite"/></circle>
    <circle cx="560" cy="25" r="1.7"><animate attributeName="opacity" values="0.1;1;0.1" dur="3.4s" repeatCount="indefinite"/></circle>
    <circle cx="690" cy="60" r="1.4"><animate attributeName="opacity" values="1;0.1;1" dur="2.6s" repeatCount="indefinite"/></circle>
    <circle cx="740" cy="130" r="1.8"><animate attributeName="opacity" values="0.2;1;0.2" dur="3.7s" repeatCount="indefinite"/></circle>
    <circle cx="40" cy="150" r="1.5"><animate attributeName="opacity" values="1;0.2;1" dur="2.9s" repeatCount="indefinite"/></circle>
  </g>

  <!-- orbit ring + satellite -->
  <ellipse cx="400" cy="160" rx="250" ry="55" fill="none" stroke="#22D3EE" stroke-opacity="0.22" stroke-dasharray="4 8"/>
  <circle r="6" fill="#10B981">
    <animateMotion dur="9s" repeatCount="indefinite" path="M150 160 a250 55 0 1 0 500 0 a250 55 0 1 0 -500 0"/>
  </circle>
  <circle r="3" fill="#22D3EE">
    <animateMotion dur="9s" begin="-4.5s" repeatCount="indefinite" path="M150 160 a250 55 0 1 0 500 0 a250 55 0 1 0 -500 0"/>
  </circle>

  <!-- glow -->
  <circle cx="400" cy="160" r="120" fill="url(#glow)">
    <animate attributeName="r" values="110;130;110" dur="3s" repeatCount="indefinite"/>
  </circle>

  <!-- floating code symbols -->
  <g font-family="JetBrains Mono, Consolas, monospace" font-size="18" fill="#22D3EE">
    <text x="120" y="230">&lt;/&gt;
      <animateTransform attributeName="transform" type="translate" values="0 0;0 -70" dur="5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0;1;0" dur="5s" repeatCount="indefinite"/>
    </text>
    <text x="220" y="250">{ }
      <animateTransform attributeName="transform" type="translate" values="0 0;0 -80" dur="6s" begin="-2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0;1;0" dur="6s" begin="-2s" repeatCount="indefinite"/>
    </text>
    <text x="590" y="240" fill="#10B981">01
      <animateTransform attributeName="transform" type="translate" values="0 0;0 -75" dur="5.5s" begin="-1s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0;1;0" dur="5.5s" begin="-1s" repeatCount="indefinite"/>
    </text>
    <text x="670" y="225" fill="#10B981">=&gt;
      <animateTransform attributeName="transform" type="translate" values="0 0;0 -65" dur="4.5s" begin="-3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0;1;0" dur="4.5s" begin="-3s" repeatCount="indefinite"/>
    </text>
    <text x="70" y="215" fill="#D7E0F2">npm
      <animateTransform attributeName="transform" type="translate" values="0 0;0 -60" dur="7s" begin="-4s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0;0.9;0" dur="7s" begin="-4s" repeatCount="indefinite"/>
    </text>
  </g>

  <!-- speech bubble -->
  <g>
    <rect x="470" y="36" width="180" height="50" rx="12" fill="#0A101F" stroke="#22D3EE" stroke-width="1.5"/>
    <path d="M470 70 L452 92 L488 86 Z" fill="#0A101F" stroke="#22D3EE" stroke-width="1.5" stroke-linejoin="round"/>
    <rect x="466" y="66" width="30" height="22" fill="#0A101F" opacity="0"/>
    <text x="484" y="68" font-family="JetBrains Mono, Consolas, monospace" font-size="15" fill="#D7E0F2" clip-path="url(#typeclip)">Hello, World!</text>
    <rect x="636" y="52" width="2" height="18" fill="#22D3EE">
      <animate attributeName="opacity" values="1;0;1" dur="0.9s" repeatCount="indefinite"/>
    </rect>
  </g>

  <!-- shadow -->
  <ellipse cx="400" cy="272" rx="52" ry="6" fill="#22D3EE" opacity="0.18">
    <animate attributeName="rx" values="52;38;52" dur="3s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.18;0.08;0.18" dur="3s" repeatCount="indefinite"/>
  </ellipse>

  <!-- robot (floating) -->
  <g>
    <animateTransform attributeName="transform" type="translate" values="0 0;0 -10;0 0" dur="3s" repeatCount="indefinite"/>

    <!-- antenna -->
    <line x1="400" y1="82" x2="400" y2="64" stroke="#22D3EE" stroke-width="3" stroke-linecap="round"/>
    <circle cx="400" cy="58" r="7" fill="#10B981">
      <animate attributeName="opacity" values="1;0.25;1" dur="1.2s" repeatCount="indefinite"/>
      <animate attributeName="r" values="7;9;7" dur="1.2s" repeatCount="indefinite"/>
    </circle>

    <!-- ears -->
    <rect x="338" y="116" width="12" height="26" rx="4" fill="#164E63" stroke="#22D3EE" stroke-width="1.5"/>
    <rect x="450" y="116" width="12" height="26" rx="4" fill="#164E63" stroke="#22D3EE" stroke-width="1.5"/>

    <!-- head -->
    <rect x="350" y="82" width="100" height="78" rx="20" fill="url(#body)" stroke="#22D3EE" stroke-width="2"/>
    <!-- visor -->
    <rect x="362" y="98" width="76" height="34" rx="12" fill="#0A101F" stroke="#164E63" stroke-width="1.5"/>
    <!-- eyes -->
    <ellipse cx="381" cy="115" rx="9" ry="10" fill="#22D3EE">
      <animate attributeName="ry" values="10;10;1;10;10" keyTimes="0;0.88;0.92;0.96;1" dur="4s" repeatCount="indefinite"/>
    </ellipse>
    <ellipse cx="419" cy="115" rx="9" ry="10" fill="#22D3EE">
      <animate attributeName="ry" values="10;10;1;10;10" keyTimes="0;0.88;0.92;0.96;1" dur="4s" repeatCount="indefinite"/>
    </ellipse>
    <!-- smile -->
    <path d="M384 144 Q400 156 416 144" fill="none" stroke="#10B981" stroke-width="3" stroke-linecap="round"/>

    <!-- neck -->
    <rect x="390" y="160" width="20" height="10" fill="#164E63"/>

    <!-- body -->
    <rect x="358" y="170" width="84" height="76" rx="16" fill="url(#body)" stroke="#22D3EE" stroke-width="2"/>
    <rect x="378" y="186" width="44" height="28" rx="7" fill="#0A101F" stroke="#10B981" stroke-width="1.5"/>
    <circle cx="390" cy="200" r="4" fill="#22D3EE"><animate attributeName="opacity" values="1;0.2;1" dur="1s" repeatCount="indefinite"/></circle>
    <circle cx="400" cy="200" r="4" fill="#10B981"><animate attributeName="opacity" values="0.2;1;0.2" dur="1s" repeatCount="indefinite"/></circle>
    <circle cx="410" cy="200" r="4" fill="#D7E0F2"><animate attributeName="opacity" values="1;0.2;1" dur="1.4s" repeatCount="indefinite"/></circle>
    <rect x="384" y="226" width="32" height="5" rx="2.5" fill="#22D3EE" opacity="0.5"/>

    <!-- left arm (static) -->
    <rect x="334" y="178" width="20" height="52" rx="10" fill="#164E63" stroke="#22D3EE" stroke-width="1.5"/>
    <circle cx="344" cy="234" r="9" fill="#22D3EE"/>

    <!-- right arm (waving) -->
    <g>
      <animateTransform attributeName="transform" type="rotate"
        values="-100 452 184;-145 452 184;-100 452 184;-145 452 184;-100 452 184;0 452 184;0 452 184"
        keyTimes="0;0.12;0.24;0.36;0.48;0.62;1" dur="5s" repeatCount="indefinite"/>
      <rect x="442" y="178" width="20" height="52" rx="10" fill="#164E63" stroke="#22D3EE" stroke-width="1.5"/>
      <circle cx="452" cy="234" r="9" fill="#22D3EE"/>
    </g>

    <!-- legs -->
    <rect x="374" y="246" width="20" height="18" rx="6" fill="#164E63" stroke="#22D3EE" stroke-width="1.5"/>
    <rect x="406" y="246" width="20" height="18" rx="6" fill="#164E63" stroke="#22D3EE" stroke-width="1.5"/>
  </g>
</svg>












<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 90" width="800" height="90" role="img" aria-label="Small robot walking along a line" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <!-- ground -->
  <line x1="0" y1="72" x2="800" y2="72" stroke="#164E63" stroke-width="2" stroke-dasharray="10 8">
    <animate attributeName="stroke-dashoffset" values="0;-36" dur="1s" repeatCount="indefinite"/>
  </line>

  <!-- data bits on the ground -->
  <g fill="#22D3EE">
    <circle cx="120" cy="60" r="2.5"><animate attributeName="opacity" values="0.2;1;0.2" dur="2s" repeatCount="indefinite"/></circle>
    <circle cx="300" cy="60" r="2.5"><animate attributeName="opacity" values="1;0.2;1" dur="2.4s" repeatCount="indefinite"/></circle>
    <circle cx="480" cy="60" r="2.5"><animate attributeName="opacity" values="0.2;1;0.2" dur="1.8s" repeatCount="indefinite"/></circle>
    <circle cx="660" cy="60" r="2.5"><animate attributeName="opacity" values="1;0.2;1" dur="2.2s" repeatCount="indefinite"/></circle>
  </g>

  <!-- walking robot -->
  <g>
    <animateTransform attributeName="transform" type="translate" values="-50 0;830 0" dur="14s" repeatCount="indefinite"/>

    <g>
      <animateTransform attributeName="transform" type="translate" values="0 0;0 -2;0 0" dur="0.5s" repeatCount="indefinite"/>

      <!-- antenna -->
      <line x1="12" y1="24" x2="12" y2="16" stroke="#22D3EE" stroke-width="2" stroke-linecap="round"/>
      <circle cx="12" cy="13" r="3" fill="#10B981">
        <animate attributeName="opacity" values="1;0.2;1" dur="0.8s" repeatCount="indefinite"/>
      </circle>

      <!-- head -->
      <rect x="1" y="24" width="22" height="18" rx="6" fill="#164E63" stroke="#22D3EE" stroke-width="1.5"/>
      <circle cx="8" cy="33" r="2.5" fill="#22D3EE"/>
      <circle cx="17" cy="33" r="2.5" fill="#22D3EE"/>

      <!-- body -->
      <rect x="3" y="43" width="18" height="16" rx="5" fill="#164E63" stroke="#22D3EE" stroke-width="1.5"/>
      <circle cx="12" cy="51" r="2.5" fill="#10B981"/>

      <!-- arms -->
      <rect x="-3" y="44" width="5" height="12" rx="2.5" fill="#22D3EE">
        <animateTransform attributeName="transform" type="rotate" values="-25 0 45;25 0 45;-25 0 45" dur="0.5s" repeatCount="indefinite"/>
      </rect>
      <rect x="22" y="44" width="5" height="12" rx="2.5" fill="#22D3EE">
        <animateTransform attributeName="transform" type="rotate" values="25 24 45;-25 24 45;25 24 45" dur="0.5s" repeatCount="indefinite"/>
      </rect>

      <!-- legs -->
      <rect x="5" y="59" width="6" height="12" rx="3" fill="#22D3EE">
        <animateTransform attributeName="transform" type="rotate" values="-28 8 59;28 8 59;-28 8 59" dur="0.5s" repeatCount="indefinite"/>
      </rect>
      <rect x="13" y="59" width="6" height="12" rx="3" fill="#10B981">
        <animateTransform attributeName="transform" type="rotate" values="28 16 59;-28 16 59;28 16 59" dur="0.5s" repeatCount="indefinite"/>
      </rect>
    </g>

    <!-- speech snippet -->
    <text x="34" y="28" font-family="JetBrains Mono, Consolas, monospace" font-size="11" fill="#22D3EE" opacity="0.85">npm run dev
      <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.6s" repeatCount="indefinite"/>
    </text>
  </g>
</svg>
























